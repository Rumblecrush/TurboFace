# PvP enemy-player max-health estimator used by DoT prediction. UI-independent.
Combat\PvPHealthEstimate.lua

# DoT prediction engine. Must load BEFORE the nameplate and unit frame files:
# they register as consumers at file scope. Needs only ns.CLEU (Config) and
# ns.API (Compat), both loaded above.
Combat\DotPrediction.lua

# Incoming-heal prediction engine. UI-independent; the Blizzard-bar prediction renderer consumes it.
Combat\HealPrediction.lua

# Lightweight local damage/DPS meter for leveling and party/dungeon content.
Combat\CombatMeter.lua
# Independent Blizzard PlayerFrame DPS/HPS badge; headless consumer of CombatMeter accounting.
Combat\DPSBadge.lua
# Independent enemy leash countdown; shared CLEU + demand-driven cadence.
Combat\LeashTimer.lua

